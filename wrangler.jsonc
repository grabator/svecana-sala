// Cloudflare Workers: stranica (statični fajlovi) + /api/zauzeto (Google Kalendar).
// ICS_URL se NE upisuje ovdje nego u Cloudflare: Settings -> Variables and Secrets (vidi README).
{
  "name": "svecana-sala",
  "main": "worker/zauzeto.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
